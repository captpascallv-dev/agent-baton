<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('OSX'))">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('OSX'))">net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CliWatch.Contracts" Condition="!$([MSBuild]::IsOSPlatform('OSX'))"><HintPath>$(CliWatchRuntimeDirectory)/CliWatch.Contracts.dll</HintPath><ExternallyResolved>true</ExternallyResolved></Reference>
    <ProjectReference Include="../collection/AiMoeStudio.Collection.csproj" Condition="'$(UseInstalledCollector)' != 'true'" />
    <Reference Include="CliWatch.Collection" Condition="'$(UseInstalledCollector)' == 'true'"><HintPath>$(CliWatchRuntimeDirectory)/CliWatch.Collection.dll</HintPath><ExternallyResolved>true</ExternallyResolved></Reference>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ProjectReference Include="../../../watch/src/CliWatch.Contracts/CliWatch.Contracts.csproj" />
  </ItemGroup>
</Project>
