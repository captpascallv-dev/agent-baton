<UserControl x:Class="CliWatch.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Focusable="True"
             Language="zh-CN">
  <UserControl.Resources>
    <SolidColorBrush x:Key="HudBg" Color="#FFF4F5F7"/>
    <SolidColorBrush x:Key="HudPanel" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="HudInset" Color="#FFF7F8F9"/>
    <SolidColorBrush x:Key="HudLine" Color="#FFE8EAED"/>
    <SolidColorBrush x:Key="HudText" Color="#FF1C2026"/>
    <SolidColorBrush x:Key="HudMuted" Color="#FF5C6570"/>
    <SolidColorBrush x:Key="HudFaint" Color="#FF8B939C"/>
    <SolidColorBrush x:Key="HudMint" Color="#FF2D9A62"/>
    <SolidColorBrush x:Key="ToneActive" Color="#FF2D9A62"/>
    <SolidColorBrush x:Key="ToneActiveTint" Color="#FFE8F6EE"/>
    <SolidColorBrush x:Key="ToneQuiet" Color="#FFC9782A"/>
    <SolidColorBrush x:Key="ToneQuietTint" Color="#FFFBF1E6"/>
    <SolidColorBrush x:Key="ToneDelivered" Color="#FF3B6FBF"/>
    <SolidColorBrush x:Key="ToneDeliveredTint" Color="#FFEEF3FB"/>
    <SolidColorBrush x:Key="ToneFailed" Color="#FFC4473C"/>
    <SolidColorBrush x:Key="ToneFailedTint" Color="#FFF9ECEA"/>
    <Style x:Key="MutedCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource HudMuted}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource HudText}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource HudFaint}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin" Value="0,14,0,4"/>
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Background" Value="{StaticResource HudInset}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource HudText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock x:Name="EmptyText" Style="{StaticResource MutedCaption}" Visibility="Collapsed" Margin="0,20"/>
      <StackPanel x:Name="ContentPanel">
        <DockPanel LastChildFill="True">
          <Border x:Name="BadgeHost" DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="10"
                  Padding="8,3" Background="{StaticResource HudInset}" Margin="8,0,0,0">
            <TextBlock x:Name="OverallJudgmentText" FontSize="11.5" FontWeight="Medium"
                       Foreground="{StaticResource HudMuted}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" MaxWidth="180"
                       AutomationProperties.AutomationId="DetailsOverallJudgment"/>
          </Border>
          <TextBlock x:Name="ProjectLabelText" FontSize="12" Foreground="{StaticResource HudFaint}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource HudText}"
                   TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="DetailsSelectedName"/>
        <TextBlock x:Name="OverallBasisText" Style="{StaticResource MutedCaption}" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="DetailsOverallBasis"/>
        <DockPanel Margin="0,8,0,0">
          <Button x:Name="CopyJobButton" DockPanel.Dock="Right" Content="复制编号" FontSize="12"
                  Padding="8,3" Margin="8,0,0,0" Cursor="Hand" Click="OnCopyJobClick"
                  Background="{StaticResource HudInset}" BorderThickness="0" Foreground="{StaticResource HudMuted}"/>
          <TextBlock x:Name="SelectedIdText" Style="{StaticResource MutedCaption}"
                     FontFamily="Consolas" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="DetailsSelectedProjectId"/>
        </DockPanel>
        <TextBlock x:Name="MetaText" Style="{StaticResource MutedCaption}" Margin="0,4,0,0"/>
        <TextBlock x:Name="FreshnessText" Style="{StaticResource MutedCaption}" Margin="0,4,0,0" Visibility="Collapsed"/>

        <TextBlock x:Name="NowTitle" Text="当前观察" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="WhoText" Style="{StaticResource BodyText}" AutomationProperties.AutomationId="DetailsWho"/>
        <TextBlock x:Name="HowFarTitle" Text="运行与活动" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="HowFarText" Style="{StaticResource BodyText}"/>
        <TextBlock x:Name="StuckTitle" Text="需要留意" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
        <TextBlock x:Name="StuckText" Style="{StaticResource BodyText}" AutomationProperties.AutomationId="DetailsStuck"/>
        <TextBlock x:Name="NextTitle" Text="下一步" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="NextStepText" Style="{StaticResource BodyText}" AutomationProperties.AutomationId="DetailsNext"/>
        <TextBlock x:Name="UserNeedTitle" Text="要不要你处理" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="UserNeedText" Style="{StaticResource BodyText}" AutomationProperties.AutomationId="DetailsUserNeed"/>

        <TextBlock x:Name="CurrentWorkTitle" Text="执行身份" Style="{StaticResource SectionTitle}"
                   AutomationProperties.AutomationId="DetailsCurrentRolesTitle"/>
        <ItemsControl x:Name="CurrentWorkList" AutomationProperties.AutomationId="DetailsCurrentRoles">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,10" AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}">
                <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource HudText}"
                           Text="{Binding RoleLabel, Mode=OneWay}"/>
                <TextBlock Style="{StaticResource BodyText}" Margin="0,3,0,0" Text="{Binding ActorName, Mode=OneWay}"/>
                <TextBlock Style="{StaticResource MutedCaption}" Margin="0,2,0,0" Text="{Binding TaskText, Mode=OneWay}"/>
                <TextBlock Style="{StaticResource MutedCaption}" Margin="0,2,0,0">
                  <Run Text="{Binding ModelText, Mode=OneWay}"/>
                  <Run Text="  "/>
                  <Run Text="{Binding EffortText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding BlockerText, Mode=OneWay}" Style="{StaticResource MutedCaption}" Margin="0,4,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoCurrentWorkText" Style="{StaticResource MutedCaption}" Text="无当前执行身份。" Visibility="Collapsed"/>
        <TextBlock x:Name="UnassignedReviewText" Style="{StaticResource MutedCaption}" Margin="0,4,0,0" Visibility="Collapsed"
                   AutomationProperties.AutomationId="DetailsUnassignedReview"/>

        <TextBlock x:Name="UserSectionTitle" Text="待你决定" Style="{StaticResource SectionTitle}"/>
        <ItemsControl x:Name="UserList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="NavTitle" Text="本地依据" Style="{StaticResource SectionTitle}"/>
        <WrapPanel x:Name="NavPanel"/>
        <TextBlock x:Name="NoNavText" Style="{StaticResource MutedCaption}" Text="无可用本地依据。" Visibility="Collapsed"/>

        <Expander x:Name="GoalExpander" Margin="0,10,0,0" IsExpanded="False" FontSize="12.5" Foreground="{StaticResource HudMuted}">
          <Expander.Header>
            <TextBlock x:Name="GoalLabel" Text="目标与完整说明" FontSize="12.5"/>
          </Expander.Header>
          <StackPanel Margin="0,8,0,0">
            <TextBlock x:Name="GoalText" Style="{StaticResource BodyText}"/>
            <TextBlock x:Name="PhaseText" Style="{StaticResource BodyText}" Visibility="Collapsed"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource MutedCaption}" Margin="0,6,0,0"/>
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
              <TextBlock x:Name="ProgressTitle" Text="进度（仅在有可靠依据时显示）" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="ProgressText" Style="{StaticResource BodyText}"/>
            </StackPanel>
          </StackPanel>
        </Expander>

        <Expander x:Name="HistoryExpander" Margin="0,6,0,0" IsExpanded="False" FontSize="12.5" Foreground="{StaticResource HudMuted}">
          <Expander.Header>
            <TextBlock x:Name="HistoryTitle" Text="历史与诊断" FontSize="12.5"/>
          </Expander.Header>
          <StackPanel Margin="0,8,0,0">
            <ItemsControl x:Name="HistoricalWorkList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,8" AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}">
                    <TextBlock FontWeight="Medium" Foreground="{StaticResource HudMuted}"
                               Text="{Binding RoleLabel, Mode=OneWay}"/>
                    <TextBlock Text="{Binding ActorName, Mode=OneWay}" Style="{StaticResource BodyText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" Style="{StaticResource MutedCaption}" Margin="0,2,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoHistoryText" Style="{StaticResource MutedCaption}" Text="无历史条目。" Visibility="Collapsed"/>
            <StackPanel x:Name="TechnicalPanel" Visibility="Collapsed">
              <TextBlock x:Name="ArtifactTitle" Text="依据文件" Style="{StaticResource SectionTitle}"/>
              <ItemsControl x:Name="ArtifactList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource MutedCaption}" Margin="0,0,0,4">
                      <Run Text="{Binding Label, Mode=OneWay}"/>
                      <Run Text=" · "/>
                      <Run Text="{Binding State, Mode=OneWay}"/>
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="NoArtifactText" Style="{StaticResource MutedCaption}" Text="无依据文件。" Visibility="Collapsed"/>
              <TextBlock x:Name="LeadTitle" Text="原Lead待处理" Style="{StaticResource SectionTitle}"/>
              <ItemsControl x:Name="LeadList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="SecretaryTitle" Text="秘书关注" Style="{StaticResource SectionTitle}"/>
              <ItemsControl x:Name="SecretaryList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Button x:Name="DiagnosticsToggle" Content="查看技术诊断" Margin="0,8,0,0" Padding="10,5"
                    HorizontalAlignment="Left" Click="OnDiagnosticsToggle" Cursor="Hand"
                    Background="{StaticResource HudInset}" BorderThickness="0" FontSize="12"
                    Foreground="{StaticResource HudMuted}"
                    AutomationProperties.AutomationId="DiagnosticsToggle"/>
            <TextBlock x:Name="DiagnosticsText" Style="{StaticResource MutedCaption}" Margin="0,8,0,0" Visibility="Collapsed"
                       AutomationProperties.AutomationId="DetailsDiagnostics"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
