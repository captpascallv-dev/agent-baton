<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.4</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <HudSourceRevision Condition="'$(HudSourceRevision)' == ''">unknown</HudSourceRevision>
    <InformationalVersion>1.1.4+$(HudSourceRevision)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Codex Usage HUD</Product>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="HudSourceRevision" Value="$(HudSourceRevision)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexUsageHud.Core\CodexUsageHud.Core.csproj" />
  </ItemGroup>
</Project>
