<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CliWatch.Contracts"><HintPath>$(CliWatchRuntimeDirectory)/CliWatch.Contracts.dll</HintPath><ExternallyResolved>true</ExternallyResolved></Reference>
    <ProjectReference Include="../collection/AiMoeStudio.Collection.csproj" Condition="'$(UseInstalledCollector)' != 'true'" />
    <Reference Include="CliWatch.Collection" Condition="'$(UseInstalledCollector)' == 'true'"><HintPath>$(CliWatchRuntimeDirectory)/CliWatch.Collection.dll</HintPath><ExternallyResolved>true</ExternallyResolved></Reference>
  </ItemGroup>
</Project>
