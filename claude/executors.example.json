{
  "permission_notice": "The --force and --always-approve examples are optional permission choices. Keep them only if you explicitly authorize automatic command approval. Verify all flags against your installed CLI version.",
  "pointer": "Read the task card file \"{card}\" (UTF-8) in full and follow it exactly. Do nothing outside the card.",
  "executors": {
    "codex": {
      "command": "codex",
      "args": ["exec", "-m", "gpt-6.1-sol", "-c", "model_reasoning_effort=xhigh",
               "-c", "sandbox_workspace_write.network_access=true", "-s", "workspace-write",
               "-C", "{workspace}", "--add-dir", "{outbox}", "--skip-git-repo-check",
               "-o", "{jobdir}/last-message.md", "-"],
      "stdin_card": true,
      "env": { "CODEX_HOME": "" }
    },
    "cursor": {
      "command": "cursor-agent",
      "args": ["-p", "--model", "grok-4.7-xhigh", "--force", "--trust", "--workspace", "{workspace}",
               "--add-dir", "{outbox}", "--add-dir", "{carddir}", "--output-format", "text", "{pointer}"],
      "unset_env": ["SHELL", "MSYSTEM"]
    },
    "grok": {
      "command": "grok",
      "args": ["--prompt-file", "{card}", "-m", "grok-4.7", "--reasoning-effort", "xhigh",
               "--always-approve", "--cwd", "{workspace}"]
    },
    "pi": {
      "command": "pi",
      "args": ["-p", "--provider", "openai-codex", "--model", "gpt-6.1-sol", "--thinking", "xhigh",
               "--no-session", "{pointer}"],
      "args_on_resume": ["-p", "--provider", "openai-codex", "--model", "gpt-6.1-sol", "--thinking", "xhigh",
               "--resume", "{resume}", "{pointer}"]
    },
    "dsh": {
      "command": "dsh",
      "args": ["--profile", "headless", "{pointer}"]
    }
  }
}
